# MongoDB replica set/Atlas required for session transactions.
MONGODB_URL=mongodb://localhost:27017/game_service_platform?replicaSet=rs0
MONGODB_DATABASE=game_service_platform

# Supply through a secret manager in deployments. At least 32 bytes.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=jokihub-admin-api
JWT_AUDIENCE=jokihub-admin-dashboard

# Local-only example. Match this exactly to dashboard origin in browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Local test only: enables insecure localhost cookies. Use HTTPS and leave false in production.
AUTH_ALLOW_INSECURE_HTTP=true

# Optional comma-separated CIDRs for proxies allowed to set X-Forwarded-For.
TRUSTED_PROXY_CIDRS=

PORT=8080
