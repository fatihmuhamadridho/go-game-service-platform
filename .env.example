# Source platform-compatible MongoDB connection string. URI may include database path.
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
# Optional; overrides database path in MONGODB_URL. MONGODB_URI is also accepted as a local alias.
MONGODB_DATABASE=

# Required for customer/admin authentication.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional local server port.
PORT=8080

# Source-platform feature flags; registration/recovery default off.
FEATURE_REGISTER=false
FEATURE_PASSWORD_RECOVERY=false

# Optional Vercel Blob storage; required for payment-proof uploads.
BLOB_READ_WRITE_TOKEN=
FEATURE_SPRINT_2=false

# Payment instructions; configure before enabling checkout.
PAYMENT_BCA_BANK_NAME=
PAYMENT_BCA_ACCOUNT_NUMBER=
PAYMENT_BCA_ACCOUNT_HOLDER=
PAYMENT_QRIS_IMAGE_URL=

# Optional password recovery email delivery (required when FEATURE_PASSWORD_RECOVERY=true).
APP_BASE_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
